# Local credentials and editor/temporary files; examples may be versioned.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.p12
*.pfx
export_credentials.cfg
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# ADC runtime output belongs in user://; exclude optional local test/report copies too.
**/.adc-output/
**/diagnostics-output/

# Regenerated art-validation reports; keep the tests, catalogs and source assets.
/godot_client/data/*_validation.json
